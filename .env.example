# ── Gateway ──────────────────────────────────────────────
GATEWAY_ENV=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=1
GATEWAY_LOG_LEVEL=INFO

# ── Ollama ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0
OLLAMA_MAX_RETRIES=3

# ── Model Routing ─────────────────────────────────────────
# Requests with estimated tokens BELOW this → fast tier
ROUTING_FAST_TIER_TOKEN_THRESHOLD=300
# Requests with complexity score BELOW this → fast tier  
ROUTING_FAST_TIER_COMPLEXITY_THRESHOLD=0.4
# Fast tier model
ROUTING_FAST_MODEL=mistral:latest
# Quality tier model
ROUTING_QUALITY_MODEL=llama3.2:latest
# SLA: max acceptable latency in ms before DLQ (Phase 2)
ROUTING_SLA_TIMEOUT_MS=30000

# ── Redis (Phase 2) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Observability ────────────────────────────────────────
OTEL_SERVICE_NAME=inference-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
